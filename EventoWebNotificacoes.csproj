<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="external/BaileysCSharp/BaileysCSharp/BaileysCSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- external/ contains the BaileysCSharp submodule, consumed only via ProjectReference above;
         without this, the SDK's default glob would also compile its sources (and its Tests project) directly. -->
    <Compile Remove="external/**" />
    <Content Remove="external/**" />
    <EmbeddedResource Remove="external/**" />
    <None Remove="external/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="RabbitMQ.Client" Version="7.2.2" />
    <PackageReference Include="Scriban" Version="7.2.6" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="LiteDB" Version="5.0.21" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
